{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "build",
        "workflow"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,100}$"
    },
    "description": {
      "type": "string"
    },
    "environment": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "shell": {
          "type": "string",
          "minLength": 1
        },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "subdir": {
                "type": "string",
                "minLength": 1
              },
              "timeout_seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "url",
              "sha256"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "workflow": {
            "type": "string",
            "minLength": 1
          },
          "output": {
            "type": "string",
            "minLength": 1
          },
          "contract": {
            "enum": [
              "cmake-prefix/v1"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "policy": {
            "enum": [
              "reuse-or-build",
              "reuse-only",
              "rebuild"
            ]
          },
          "artifact": {
            "type": "string",
            "minLength": 1
          },
          "build": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "output"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "build"
            ]
          },
          {
            "required": [
              "workflow"
            ]
          }
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,100}$"
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "uses": {
            "enum": [
              "apt.install",
              "cmake.project",
              "command",
              "check"
            ]
          },
          "timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "with": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "uses",
          "with"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "uses": {
                  "const": "apt.install"
                }
              }
            },
            "then": {
              "properties": {
                "with": {
                  "type": "object",
                  "properties": {
                    "specs": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "specs"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "uses": {
                  "const": "cmake.project"
                }
              }
            },
            "then": {
              "properties": {
                "with": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "executable": {
                      "type": "string",
                      "minLength": 1
                    },
                    "configure_preset": {
                      "type": "string",
                      "minLength": 1
                    },
                    "build_preset": {
                      "type": "string",
                      "minLength": 1
                    },
                    "test_preset": {
                      "type": "string",
                      "minLength": 1
                    },
                    "toolchain_file": {
                      "type": "string",
                      "minLength": 1
                    },
                    "configuration": {
                      "type": "string",
                      "minLength": 1
                    },
                    "component": {
                      "type": "string",
                      "minLength": 1
                    },
                    "targets": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "cache": {
                      "type": "object",
                      "propertyNames": {
                        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
                      },
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "enum": [
                              "BOOL",
                              "STRING",
                              "PATH",
                              "FILEPATH"
                            ]
                          },
                          "value": {
                            "type": [
                              "string",
                              "boolean",
                              "number",
                              "array"
                            ],
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "type",
                          "value"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "phases": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "enum": [
                          "configure",
                          "build",
                          "install",
                          "test"
                        ]
                      }
                    },
                    "dependencies": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "paths": {
                      "type": "object",
                      "propertyNames": {
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                      },
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required_files": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "export": {
                      "type": "object",
                      "properties": {
                        "package": {
                          "type": "string",
                          "minLength": 1
                        },
                        "cmake_dir": {
                          "type": "string",
                          "minLength": 1
                        },
                        "activation": {
                          "type": "string",
                          "minLength": 1
                        },
                        "paths": {
                          "type": "object",
                          "propertyNames": {
                            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                          },
                          "additionalProperties": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
                        "features": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "version": {
                          "type": "string",
                          "minLength": 1
                        },
                        "contract": {
                          "enum": [
                            "cmake-prefix/v1"
                          ]
                        },
                        "runtime_packages": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "package",
                        "version"
                      ],
                      "additionalProperties": false
                    },
                    "generator": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "source"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "uses": {
                  "const": "command"
                }
              }
            },
            "then": {
              "properties": {
                "with": {
                  "type": "object",
                  "properties": {
                    "argv": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "cwd": {
                      "type": "string",
                      "minLength": 1
                    },
                    "dependencies": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "paths": {
                      "type": "object",
                      "propertyNames": {
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                      },
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "artifacts": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "argv"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "uses": {
                  "const": "check"
                }
              }
            },
            "then": {
              "properties": {
                "with": {
                  "type": "object",
                  "required": [
                    "spec"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "spec": {
                      "type": "object"
                    },
                    "dependencies": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1
          },
          "publish_after": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "step",
          "publish_after"
        ],
        "additionalProperties": false
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "linux",
          "darwin"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "steps"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
