{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis-forge.local/schemas/suite-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "description": {
      "type": "string"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shell": {
          "type": "string",
          "minLength": 1
        },
        "variables": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "name": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "$ref": "#/$defs/id"
        }
      },
      "not": {
        "required": [
          "shell",
          "name"
        ]
      },
      "dependentRequired": {
        "revision": [
          "name"
        ]
      }
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "oneOf": [
          {
            "required": [
              "argv"
            ]
          },
          {
            "required": [
              "script"
            ]
          }
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "script": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "needs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 604800
          },
          "expect_exit_code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "artifacts": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    }
  }
}
