{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "version",
    "description",
    "source",
    "install",
    "check"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9+._-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,63}$"
    },
    "description": {
      "type": "string"
    },
    "homepage": {
      "type": "string"
    },
    "provenance": {
      "type": "object"
    },
    "depends": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "requires_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_+.-]+$"
      },
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sha256",
        "subdir"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https|file)://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "subdir": {
          "type": "string",
          "minLength": 1
        },
        "patch_archive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "sha256"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^(https|file)://"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "url",
              "sha256"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^(https|file)://"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
              }
            }
          }
        }
      }
    },
    "build": {
      "$ref": "#/$defs/commands"
    },
    "install": {
      "$ref": "#/$defs/commands"
    },
    "check": {
      "$ref": "#/$defs/commands"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "set": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "prepend": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "build_depends": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "run_depends": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "probe": {
      "$ref": "#/$defs/commands"
    },
    "dependency_check": {
      "$ref": "#/$defs/commands"
    },
    "debian_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alternatives",
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "build",
              "run"
            ]
          },
          "alternatives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9+._-]{0,127}$"
                },
                "relation": {
                  "enum": [
                    "<<",
                    "<=",
                    "=",
                    ">=",
                    ">>"
                  ]
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "dependentRequired": {
                "relation": [
                  "version"
                ],
                "version": [
                  "relation"
                ]
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 1
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "build_depends"
              ]
            },
            {
              "required": [
                "run_depends"
              ]
            },
            {
              "required": [
                "probe"
              ]
            },
            {
              "required": [
                "dependency_check"
              ]
            },
            {
              "required": [
                "debian_dependencies"
              ]
            },
            {
              "required": [
                "artifacts"
              ]
            }
          ]
        },
        "properties": {
          "source": {
            "not": {
              "required": [
                "components"
              ]
            }
          }
        }
      }
    }
  ]
}
