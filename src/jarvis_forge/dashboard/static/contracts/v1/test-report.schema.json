        "status": {
          "enum": [
            "pending",
            "passed",
            "failed",
            "unobserved",
            "not_applicable"
          ]
        },
        "observed": {},
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_status": {
          "enum": [
            "pending",
            "passed",
            "rejected"
