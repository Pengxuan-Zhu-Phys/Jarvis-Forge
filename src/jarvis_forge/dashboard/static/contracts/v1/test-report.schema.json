            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "error": {
              "type": "integer",
              "minimum": 0
            },
            "skipped": {
              "type": "integer",
              "minimum": 0
            },
            "xfailed": {
              "type": "integer",
              "minimum": 0
            },
            "xpassed": {
              "type": "integer",
              "minimum": 0
