        "step_id": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "instance_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "definition_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "parameters": {},
        "group": {
          "type": "object"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "finished",
            "interrupted",
            "not_run"
          ]
